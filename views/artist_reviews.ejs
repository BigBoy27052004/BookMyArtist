<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Reviews | BookMyArtist</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: #0f172a;
      color: #f8fafc;
      min-height: 100vh;
    }

    nav {
      width: 100%;
      padding: 18px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.97);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .logo {
      font-size: 25px;
      font-weight: 700;
      color: white;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      gap: 22px;
      align-items: center;
    }

    .nav-links a,
    .logout {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 13px;
      transition: 0.3s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: #6c63ff;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .profile-pic {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #6c63ff;
    }

    .logout:hover {
      color: #ef4444;
    }

    main {
      max-width: 1200px;
      margin: auto;
      padding: 125px 25px 50px;
    }

    .page-heading {
      margin-bottom: 30px;
    }

    .page-heading h1 {
      font-size: 30px;
      margin-bottom: 8px;
    }

    .page-heading p {
      color: #94a3b8;
      font-size: 14px;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 35px;
    }

    .summary-card {
      padding: 25px;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
    }

    .summary-card p {
      color: #94a3b8;
      font-size: 13px;
      margin-bottom: 10px;
    }

    .summary-card h2 {
      font-size: 30px;
    }

    .stars {
      color: #fbbf24;
      letter-spacing: 2px;
    }

    .section-title {
      font-size: 20px;
      margin-bottom: 18px;
    }

    .review-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 18px;
    }

    .review-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 14px;
    }

    .reviewer {
      font-weight: 600;
      margin-bottom: 5px;
    }

    .review-date {
      color: #94a3b8;
      font-size: 12px;
    }

    .event-name {
      display: inline-block;
      color: #c4b5fd;
      background: rgba(108, 99, 255, 0.12);
      padding: 5px 10px;
      border-radius: 7px;
      font-size: 12px;
      margin-bottom: 12px;
    }

    .review-text {
      color: #cbd5e1;
      font-size: 14px;
      line-height: 1.8;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .empty-state {
      text-align: center;
      padding: 55px 20px;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
    }

    .empty-state i {
      font-size: 42px;
      color: #6c63ff;
      margin-bottom: 18px;
    }

    .empty-state h3 {
      margin-bottom: 10px;
    }

    .empty-state p {
      color: #94a3b8;
      font-size: 14px;
    }

    @media (max-width: 900px) {
      nav {
        flex-wrap: wrap;
        gap: 15px;
      }

      .nav-links {
        order: 3;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 4px;
      }

      .nav-right {
        margin-left: auto;
      }

      main {
        padding-top: 155px;
      }
    }

    @media (max-width: 600px) {
      .summary {
        grid-template-columns: 1fr;
      }

      .page-heading h1 {
        font-size: 25px;
      }

      .review-top {
        flex-direction: column;
      }

      .logo {
        font-size: 21px;
      }

      main {
        padding-left: 16px;
        padding-right: 16px;
      }
    }
  </style>
</head>

<body>

  <nav>
    <div class="logo">BookMyArtist</div>

    <div class="nav-links">
      <a href="/artist-dashboard">Dashboard</a>
      <a href="/bookings/artist">Booking Requests</a>
      <a href="/messages">Messages</a>
      <a href="/reviews/artist" class="active">Reviews</a>
      <a href="/artists/my-profile">Profile</a>
    </div>

    <div class="nav-right">
      <% if (artist.profile_image && artist.profile_image !== "default.jpeg") { %>
      <img src="/uploads/artist-images/<%= artist.profile_image %>" alt="Profile" class="profile-pic">
      <% } else { %>
      <div class="profile-pic" style="background:#6c63ff;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">
        <%= artist.stage_name.charAt(0).toUpperCase() %>
      </div>
      <% } %>

      <a href="/auth/logout" class="logout">Logout</a>
    </div>
  </nav>

  <main>
    <div class="page-heading">
      <h1>My Reviews</h1>
      <p>See what customers are saying about your performances.</p>
    </div>

    <div class="summary">
      <div class="summary-card">
        <p>Average Rating</p>
        <h2>
          <i class="fa-solid fa-star stars"></i>
          <%= averageRating.toFixed(1) %> <small style="font-size:14px;color:#94a3b8;">/ 5</small>
        </h2>
        <div class="stars" style="margin-top:8px;">
          <% for (let i = 1; i <= 5; i++) { %>
          <i class="<%= i <= Math.round(averageRating) ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
          <% } %>
        </div>
      </div>

      <div class="summary-card">
        <p>Total Reviews</p>
        <h2><%= totalReviews %></h2>
        <p style="margin-top:8px;margin-bottom:0;">
          Customer feedback received
        </p>
      </div>
    </div>

    <h2 class="section-title">Customer Feedback</h2>

    <% if (reviews.length > 0) { %>

    <% reviews.forEach(function(review) { %>
    <div class="review-card">

      <div class="review-top">
        <div>
          <div class="reviewer">
            <%= review.first_name %> <%= review.last_name %>
          </div>

          <div class="review-date">
            <i class="fa-regular fa-calendar"></i>
            <%= new Date(review.created_at).toLocaleDateString('en-ZA', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric'
                }) %>
          </div>
        </div>

        <div class="stars" aria-label="<%= review.rating %> out of 5 stars">
          <% for (let i = 1; i <= 5; i++) { %>
          <i class="<%= i <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
          <% } %>
        </div>
      </div>

      <% if (review.event_name) { %>
      <div class="event-name">
        <i class="fa-solid fa-music"></i>
        <%= review.event_name %>
      </div>
      <% } %>

      <p class="review-text"><%= review.review || "No written comment was provided." %></p>

    </div>
    <% }); %>

    <% } else { %>

    <div class="empty-state">
      <i class="fa-regular fa-star"></i>
      <h3>No reviews yet</h3>
      <p>Once customers leave reviews for your performances, they'll appear here.</p>
    </div>

    <% } %>

  </main>

</body>

</html>
