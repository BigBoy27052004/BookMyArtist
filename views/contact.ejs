<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact - BookMyArtist</title>

    <link rel="stylesheet" href="/css/contact.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


<!-- ================= NAVBAR ================= -->

<nav>

    <div class="logo">
        BookMyArtist
    </div>


    <div class="nav-links">

        <a href="/">Home</a>

        <a href="/artists">Artists</a>

        <a href="/features">Features</a>

        <a href="/about">About</a>

        <a href="/contact" class="active">Contact</a>

    </div>


    <div class="nav-buttons">

        <a href="/auth/login" class="btn login-btn">
            Login
        </a>

        <a href="/auth/register" class="btn signup-btn">
            Sign Up
        </a>

    </div>

</nav>



<!-- ================= HERO ================= -->

<section class="contact-hero">

    <div class="contact-hero-content">

        <p class="hero-label">
            GET IN TOUCH
        </p>

        <h1>
            We'd Love to
            <span>Hear From You</span>
        </h1>

        <p>
            Have a question, suggestion or need assistance?
            Send us a message and we'll be happy to help.
        </p>

    </div>

</section>



<!-- ================= CONTACT ================= -->

<section class="contact-section">


    <div class="contact-container">


        <!-- CONTACT INFORMATION -->

        <div class="contact-info">

            <p class="section-label">
                CONTACT US
            </p>

            <h2>
                Let's Talk
            </h2>

            <p class="intro">
                Whether you're looking for an artist, interested in
                joining the platform or need help with your account,
                we're here to assist.
            </p>


            <div class="contact-item">

                <div class="contact-icon">

                    <i class="fa-solid fa-envelope"></i>

                </div>

                <div>

                    <h3>Email</h3>

                    <p>
                        support@bookmyartist.com
                    </p>

                </div>

            </div>


            <div class="contact-item">

                <div class="contact-icon">

                    <i class="fa-solid fa-phone"></i>

                </div>

                <div>

                    <h3>Phone</h3>

                    <p>
                        +27 00 000 0000
                    </p>

                </div>

            </div>


            <div class="contact-item">

                <div class="contact-icon">

                    <i class="fa-solid fa-location-dot"></i>

                </div>

                <div>

                    <h3>Location</h3>

                    <p>
                        South Africa
                    </p>

                </div>

            </div>


        </div>



        <!-- CONTACT FORM -->

        <div class="contact-form-card">

            <h2>
                Send Us a Message
            </h2>

            <p>
                Fill in the form below and we'll get back to you.
            </p>
<% if (success) { %>

    <div class="success-message">
        <i class="fa-solid fa-circle-check"></i>
        Your message has been sent successfully!
    </div>

<% } %>

            <form action="/contact" method="POST">


                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="subject">
                        Subject
                    </label>

                    <input
                        type="text"
                        id="subject"
                        name="subject"
                        placeholder="What is your message about?"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="message">
                        Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        placeholder="Write your message here..."
                        required
                    ></textarea>

                </div>


                <button
                    type="submit"
                    class="submit-btn"
                >

                    <i class="fa-solid fa-paper-plane"></i>

                    Send Message

                </button>


            </form>

        </div>


    </div>

</section>



<!-- ================= FAQ ================= -->

<section class="faq">

    <div class="section-title">

        <p class="section-label">
            FAQ
        </p>

        <h2>
            Frequently Asked Questions
        </h2>

    </div>


    <div class="faq-grid">


        <div class="faq-card">

            <h3>
                How do I book an artist?
            </h3>

            <p>
                Browse the available artists, open an artist profile
                and select the booking option to submit your event
                details.
            </p>

        </div>


        <div class="faq-card">

            <h3>
                Can artists join BookMyArtist?
            </h3>

            <p>
                Yes. Artists can create an account and build a profile
                to showcase their information and receive booking
                requests.
            </p>

        </div>


        <div class="faq-card">

            <h3>
                How can I track my booking?
            </h3>

            <p>
                Customers can use their dashboard to view their
                bookings and monitor their current status.
            </p>

        </div>


        <div class="faq-card">

            <h3>
                Can I leave a review?
            </h3>

            <p>
                Customers can rate and review artists after completing
                eligible bookings.
            </p>

        </div>


    </div>

</section>



<!-- ================= FOOTER ================= -->

<footer>

    <div class="socials">

        <i class="fa-brands fa-facebook"></i>

        <i class="fa-brands fa-instagram"></i>

        <i class="fa-brands fa-tiktok"></i>

    </div>


    <p>
        &copy; 2026 BookMyArtist. All rights reserved.
    </p>

</footer>


</body>

</html>
