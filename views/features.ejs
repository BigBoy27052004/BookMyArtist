<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Features - BookMyArtist</title>

    <link rel="stylesheet" href="/css/features.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body>

<!-- ================= NAVBAR ================= -->

<nav>

    <div class="logo">
        BookMyArtist
    </div>

    <div class="nav-links">

        <a href="/">Home</a>
        <a href="/artists">Artists</a>
        <a href="/features" class="active">Features</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>

    </div>

    <div class="nav-buttons">

        <a href="/auth/login" class="btn login-btn">
            Login
        </a>

        <a href="/auth/register" class="btn signup-btn">
            Sign Up
        </a>

    </div>

</nav>


<!-- ================= HERO ================= -->

<section class="features-hero">

    <div class="hero-content">

        <p class="hero-label">
            EVERYTHING YOU NEED
        </p>

        <h1>
            Powerful Features for
            <span>Seamless Bookings</span>
        </h1>

        <p>
            BookMyArtist brings artists and event organisers together
            through a simple, convenient and reliable booking platform.
        </p>

    </div>

</section>


<!-- ================= FEATURES ================= -->

<section class="features">

    <div class="section-title">

        <h2>Everything in One Place</h2>

        <p>
            Discover the tools that make finding and booking artists easier.
        </p>

    </div>


    <div class="feature-grid">


        <!-- DISCOVER ARTISTS -->

        <div class="feature-card">

            <i class="fa-solid fa-magnifying-glass"></i>

            <h3>Discover Artists</h3>

            <p>
                Explore artists from different genres and find performers
                that match the style and requirements of your event.
            </p>

        </div>


        <!-- SEARCH -->

        <div class="feature-card">

            <i class="fa-solid fa-filter"></i>

            <h3>Search & Filter</h3>

            <p>
                Quickly find suitable artists using search and filters
                such as genre and location.
            </p>

        </div>


        <!-- AVAILABILITY -->

        <div class="feature-card">

            <i class="fa-solid fa-calendar-days"></i>

            <h3>Artist Availability</h3>

            <p>
                Check artist availability and select dates that work
                for your event before submitting a booking request.
            </p>

        </div>


        <!-- BOOKING -->

        <div class="feature-card">

            <i class="fa-solid fa-calendar-check"></i>

            <h3>Easy Booking</h3>

            <p>
                Submit your event details and send a structured booking
                request directly to your chosen artist.
            </p>

        </div>


        <!-- BOOKING STATUS -->

        <div class="feature-card">

            <i class="fa-solid fa-list-check"></i>

            <h3>Booking Tracking</h3>

            <p>
                Keep track of your booking requests as they move through
                the booking process.
            </p>

        </div>


        <!-- REVIEWS -->

        <div class="feature-card">

            <i class="fa-solid fa-star"></i>

            <h3>Ratings & Reviews</h3>

            <p>
                View ratings and reviews from previous customers to help
                you make informed decisions.
            </p>

        </div>


        <!-- NOTIFICATIONS -->

        <div class="feature-card">

            <i class="fa-solid fa-bell"></i>

            <h3>Notifications</h3>

            <p>
                Stay informed about important booking updates and
                changes through notifications.
            </p>

        </div>


        <!-- SECURITY -->

        <div class="feature-card">

            <i class="fa-solid fa-shield-halved"></i>

            <h3>Secure Accounts</h3>

            <p>
                Separate customer, artist and administrator roles help
                keep the platform organised and secure.
            </p>

        </div>

    </div>

</section>


<!-- ================= CTA ================= -->

<section class="cta">

    <div class="cta-box">

        <h2>Ready to Find Your Artist?</h2>

        <p>
            Explore talented artists and discover the perfect performer
            for your next event.
        </p>

        <a href="/artists" class="primary-btn">
            Browse Artists
        </a>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer>

    <div class="socials">

        <i class="fa-brands fa-facebook"></i>
        <i class="fa-brands fa-instagram"></i>
        <i class="fa-brands fa-tiktok"></i>

    </div>

    <p>
        &copy; 2026 BookMyArtist. All rights reserved.
    </p>

</footer>

</body>
</html>