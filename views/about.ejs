        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
</head>

<body>

<!-- ================= NAVBAR ================= -->

<nav>

    <div class="logo">
        BookMyArtist
    </div>

    <div class="nav-links">

        <a href="/">Home</a>
        <a href="/artists">Artists</a>
        <a href="/features">Features</a>
        <a href="/about" class="active">About</a>
        <a href="/contact">Contact</a>

    </div>

    <div class="nav-buttons">

        <a href="/auth/login" class="btn login-btn">
            Login
        </a>

        <a href="/auth/register" class="btn signup-btn">
            Sign Up
        </a>

    </div>

</nav>


<!-- ================= HERO ================= -->

<section class="about-hero">

    <div class="about-hero-content">

        <p class="hero-label">
            ABOUT BOOKMYARTIST
        </p>

        <h1>
            Connecting Events With
            <span>Great Artists</span>
        </h1>

        <p>
            BookMyArtist is a platform designed to make discovering,
            connecting with and booking artists easier for event
            organisers.
        </p>

    </div>

</section>


<!-- ================= OUR STORY ================= -->

<section class="story">

    <div class="story-content">

        <div class="story-text">

            <p class="section-label">
                OUR STORY
            </p>

            <h2>
                Making Artist Booking Simpler
            </h2>

            <p>
                Finding the right artist for an event can be difficult.
                Event organisers may have to search through different
                platforms, contact artists individually and wait for
                responses about availability and pricing.
            </p>

            <p>
                BookMyArtist brings these processes together in one
                centralised platform. Users can discover artists,
                explore their profiles, submit booking requests and
                manage their bookings from one place.
            </p>

            <p>
                Our goal is to create a convenient digital experience
                for both event organisers and artists.
            </p>

        </div>


        <div class="story-card">

            <div class="story-icon">
                <i class="fa-solid fa-music"></i>
            </div>

            <h3>
                One Platform
            </h3>

            <p>
                Discover. Connect. Book.
            </p>

        </div>

    </div>

</section>


<!-- ================= WHAT WE OFFER ================= -->

<section class="mission">

    <div class="section-title">

        <p class="section-label">
            WHAT WE OFFER
        </p>

        <h2>
            Built Around Your Event
        </h2>

        <p>
            BookMyArtist focuses on creating a straightforward experience
            for everyone involved in the booking process.
        </p>

    </div>


    <div class="mission-grid">

        <div class="mission-card">

            <i class="fa-solid fa-users"></i>

            <h3>
                For Event Organisers
            </h3>

            <p>
                Discover artists, compare profiles, submit booking
                requests and manage your bookings from one dashboard.
            </p>

        </div>


        <div class="mission-card">

            <i class="fa-solid fa-microphone"></i>

            <h3>
                For Artists
            </h3>

            <p>
                Create an artist profile, showcase your work and manage
                incoming booking requests in one place.
            </p>

        </div>


        <div class="mission-card">

            <i class="fa-solid fa-shield-halved"></i>

            <h3>
                Trusted Platform
            </h3>

            <p>
                Structured accounts, booking management and administrator
                controls help create an organised platform experience.
            </p>

        </div>

    </div>

</section>


<!-- ================= VISION ================= -->

<section class="vision">

    <div class="vision-box">

        <div class="vision-icon">
            <i class="fa-solid fa-lightbulb"></i>
        </div>

        <h2>
            Our Vision
        </h2>

        <p>
            To create a centralised platform where discovering and
            booking talented artists is simple, accessible and efficient.
        </p>

    </div>

</section>


<!-- ================= CTA ================= -->

<section class="cta">

    <div class="cta-box">

        <h2>
            Find the Perfect Artist
        </h2>

        <p>
            Explore artists on BookMyArtist and discover the right
            performer for your next event.
        </p>

        <a href="/artists" class="primary-btn">
            Browse Artists
        </a>

    </div>

</section>


