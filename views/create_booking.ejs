<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    Book <%= artist.stage_name %> | BookMyArtist
  </title>

  <!-- GOOGLE FONTS -->
  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- FONT AWESOME -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    /* ======================================
       GLOBAL
    ====================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: #0f172a;
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ======================================
       CUSTOMER NAVBAR
    ====================================== */

    nav {
      width: 100%;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .logo {
      font-size: 28px;
      font-weight: 700;
      color: white;
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links a {
      text-decoration: none;
      color: white;
      font-weight: 500;
      white-space: nowrap;
      transition: 0.3s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: #6c63ff;
    }

    .messages-nav-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .message-unread-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      height: 20px;
      padding: 0 6px;
      background: #ef4444;
      color: white;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .profile-pic,
    .profile-fallback {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 3px solid #6c63ff;
      flex-shrink: 0;
    }

    .profile-pic {
      object-fit: cover;
    }

    .profile-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #6c63ff;
      font-weight: 600;
      color: white;
    }

    .logout {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 15px;
      transition: 0.3s;
    }

    .logout:hover {
      color: #6c63ff;
    }

    /* ======================================
       PAGE LAYOUT
    ====================================== */

    .container {
      width: 90%;
      max-width: 850px;
      margin: 0 auto;
      padding: 45px 0 80px;
    }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: #94a3b8;
      text-decoration: none;
      margin-bottom: 25px;
      transition: 0.3s;
    }

    .back:hover {
      color: #6c63ff;
    }

    .booking-card {
      background: #1e293b;
      padding: 40px;
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    h1 {
      font-size: 34px;
      margin-bottom: 10px;
    }

    h1 span {
      color: #6c63ff;
    }

    .subtitle {
      color: #94a3b8;
      margin-bottom: 30px;
      line-height: 1.7;
      font-size: 15px;
    }

    /* ======================================
       ARTIST SUMMARY
    ====================================== */

    .artist-summary {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 22px;
      background: #0f172a;
      border-radius: 20px;
      margin-bottom: 35px;
      border: 1px solid #334155;
    }

    .artist-summary img,
    .artist-fallback {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .artist-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #6c63ff;
      font-size: 28px;
      font-weight: 700;
    }

    .artist-summary h3 {
      margin-bottom: 6px;
      font-size: 20px;
    }

    .artist-summary p {
      color: #94a3b8;
      font-size: 13px;
      line-height: 1.7;
    }

    /* ======================================
       BOOKING FORM
    ====================================== */

    .form-heading {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 25px;
    }

    .form-heading i {
      color: #6c63ff;
      margin-right: 8px;
    }

    .input-group {
      margin-bottom: 23px;
    }

    label {
      display: block;
      margin-bottom: 9px;
      font-size: 14px;
      font-weight: 500;
      color: #cbd5e1;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid #334155;
      outline: none;
      border-radius: 12px;
      background: #0f172a;
      color: white;
      font-size: 15px;
      transition: 0.3s;
    }

    input:focus {
      border-color: #6c63ff;
      box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.12);
    }

    input::placeholder {
      color: #64748b;
    }

    input[type="date"] {
      color-scheme: dark;
    }

    .field-hint {
      margin-top: 8px;
      font-size: 12px;
      color: #94a3b8;
      line-height: 1.6;
    }

    /* ======================================
       DATE AVAILABILITY FEEDBACK
    ====================================== */

    .date-availability[hidden] {
      display: none;
    }

    .date-availability {
      margin-top: 12px;
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 500;
      line-height: 1.7;
    }

    .date-availability.available {
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #86efac;
    }

    .date-availability.unavailable {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #fbbf24;
    }

    .date-availability.booked {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    /* ======================================
       SUBMIT BUTTON
    ====================================== */

    .submit-btn {
      width: 100%;
      padding: 16px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(to right,
          #6c63ff,
          #a855f7);
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 12px;
      transition: 0.3s;
    }

    .submit-btn i {
      margin-right: 8px;
    }

    .submit-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 0 20px rgba(108, 99, 255, 0.3);
    }

    .submit-btn:disabled {
      background: #475569;
      color: #94a3b8;
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
      opacity: 0.7;
    }

    .submit-btn:focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 3px;
    }

    /* ======================================
       FOOTER
    ====================================== */

    footer {
      padding: 40px 8%;
      text-align: center;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      color: #94a3b8;
      font-size: 13px;
    }

    /* ======================================
       RESPONSIVE DESIGN
    ====================================== */

    @media (max-width: 1250px) {
      nav {
        flex-wrap: wrap;
      }

      .nav-links {
        order: 3;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 18px;
      }
    }

    @media (max-width: 768px) {
      nav {
        padding: 18px 5%;
      }

      .container {
        width: 90%;
        padding-top: 30px;
      }

      .booking-card {
        padding: 25px;
      }

      h1 {
        font-size: 28px;
      }

      .artist-summary {
        padding: 16px;
        gap: 15px;
      }

      .artist-summary img,
      .artist-fallback {
        width: 65px;
        height: 65px;
      }
    }

    @media (max-width: 480px) {
      nav {
        justify-content: center;
      }

      .nav-links {
        gap: 12px 18px;
      }

      .nav-links a {
        font-size: 13px;
      }

      .booking-card {
        padding: 20px;
      }

      h1 {
        font-size: 25px;
      }

      .artist-summary h3 {
        font-size: 17px;
      }

      .nav-right {
        gap: 12px;
      }
    }
  </style>
</head>

<body>

  <!-- ======================================
       CUSTOMER NAVIGATION
  ====================================== -->

  <nav>

    <a href="/dashboard" class="logo">
      BookMyArtist
    </a>

    <div class="nav-links">

      <a href="/dashboard">
        Dashboard
      </a>

      <a href="/artists" class="active">
        Browse Artists
      </a>

      <a href="/bookings">
        My Bookings
      </a>

      <a href="/messages" class="messages-nav-link">
        Messages

        <% if (Number(unreadCount) > 0) { %>
        <span class="message-unread-badge">
          <%= unreadCount %>
        </span>
        <% } %>
      </a>

      <a href="/reviews/customer">
        Reviews
      </a>

      <a href="#" title="Customer profile coming soon">
        Profile
      </a>

    </div>

    <div class="nav-right">

      <% if (user && user.profile_image) { %>

      <img src="/uploads/artist-images/<%= user.profile_image %>" alt="Profile picture" class="profile-pic">

      <% } else { %>

      <div class="profile-fallback">
        <%= (user?.first_name || "U").charAt(0).toUpperCase() %>
      </div>

      <% } %>

      <a href="/auth/logout" class="logout">
        Logout
      </a>

    </div>

  </nav>

  <!-- ======================================
       MAIN CONTENT
  ====================================== -->

  <main class="container">

    <a href="/artists/<%= artist.artist_id %>" class="back">
      <i class="fa-solid fa-arrow-left"></i>
      Back to Artist
    </a>

    <div class="booking-card">

      <h1>
        Book <span><%= artist.stage_name %></span>
      </h1>

      <p class="subtitle">
        Complete the form below to send a booking request.
        Please select an available event date.
      </p>

      <!-- ARTIST SUMMARY -->

      <div class="artist-summary">

        <% if (artist.profile_image) { %>

        <img src="/uploads/artist-images/<%= artist.profile_image %>" alt="<%= artist.stage_name %>">

        <% } else { %>

        <div class="artist-fallback">
          <%= (artist.stage_name || "A").charAt(0).toUpperCase() %>
        </div>

        <% } %>

        <div>

          <h3><%= artist.stage_name %></h3>

          <p>
            <%= artist.genre || "Artist" %>
          </p>

          <p>
            <%= artist.city || "" %>
            <% if (artist.city && artist.province) { %>, <% } %>
            <%= artist.province || "" %>
          </p>

        </div>

      </div>

      <!-- BOOKING FORM -->

      <h2 class="form-heading">
        <i class="fa-solid fa-calendar-check"></i>
        Booking Information
      </h2>

      <form id="bookingForm" action="/bookings/create" method="POST">

        <input type="hidden" name="artist_id" value="<%= artist.artist_id %>">

        <!-- EVENT NAME -->

        <div class="input-group">

          <label for="eventName">
            Event Name
          </label>

          <input type="text" id="eventName" name="event_name" placeholder="e.g. Birthday Celebration" required>

        </div>

        <!-- EVENT DATE -->

        <div class="input-group">

          <label for="eventDate">
            Event Date
          </label>

          <input type="date" id="eventDate" name="event_date" required aria-describedby="dateAvailability">

          <p class="field-hint">
            Choose the date on which you would like
            the artist to perform.
          </p>

          <div id="dateAvailability" class="date-availability" role="status" aria-live="polite" hidden></div>

        </div>

        <!-- VENUE -->

        <div class="input-group">

          <label for="eventVenue">
            Venue
          </label>

          <input type="text" id="eventVenue" name="venue" placeholder="Enter event venue" required>

        </div>

        <!-- BOOKING AMOUNT -->

        <div class="input-group">

          <label for="bookingAmount">
            Booking Amount (R)
          </label>

          <input type="number" id="bookingAmount" name="amount" min="0" step="0.01" value="<%= artist.booking_price != null ? artist.booking_price : '' %>" required>

          <p class="field-hint">
            Booking amount in South African Rand (ZAR).
          </p>

        </div>

        <!-- SUBMIT -->

        <button type="submit" class="submit-btn" id="submitBookingBtn" disabled>
          <i class="fa-solid fa-calendar-check"></i>
          Send Booking Request
        </button>

      </form>

    </div>

  </main>

  <footer>
    © 2026 BookMyArtist. All Rights Reserved.
  </footer>

  <!-- ======================================
       AVAILABILITY DATA FROM MYSQL
  ====================================== -->

  <script id="bookingAvailabilityData" type="application/json">
    <%- JSON.stringify({
    blocked: unavailableDates.map(item => item.date),
    booked: bookedDates.map(item => item.date)
  }).replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029") %>
  </script>

  <script>
    const availabilityData = JSON.parse(
      document.getElementById(
        "bookingAvailabilityData"
      ).textContent
    );

    const blockedDates = new Set(
      availabilityData.blocked
    );

    const bookedDates = new Set(
      availabilityData.booked
    );

    const eventDateInput =
      document.getElementById("eventDate");

    const availabilityMessage =
      document.getElementById("dateAvailability");

    const submitBookingBtn =
      document.getElementById("submitBookingBtn");

    const bookingForm =
      document.getElementById("bookingForm");

    function getTodayKey() {
      const today = new Date();

      return [
        today.getFullYear(),
        String(today.getMonth() + 1).padStart(2, "0"),
        String(today.getDate()).padStart(2, "0")
      ].join("-");
    }

    function showAvailability(message, status) {
      availabilityMessage.hidden = false;
      availabilityMessage.textContent = message;
      availabilityMessage.className =
        "date-availability " + status;
    }

    function validateSelectedDate() {
      const selectedDate = eventDateInput.value;
      const today = getTodayKey();

      submitBookingBtn.disabled = true;

      if (!selectedDate) {
        availabilityMessage.hidden = true;
        return false;
      }

      if (!eventDateInput.validity.valid) {
        showAvailability(
          "Please choose a valid event date.",
          "unavailable"
        );
        return false;
      }

      if (selectedDate < today) {
        showAvailability(
          "You cannot request a booking for a past date.",
          "unavailable"
        );
        return false;
      }

      if (bookedDates.has(selectedDate)) {
        showAvailability(
          "This artist is already booked on the selected date. Please choose another date.",
          "booked"
        );
        return false;
      }

      if (blockedDates.has(selectedDate)) {
        showAvailability(
          "This artist is unavailable on the selected date. Please choose another date.",
          "unavailable"
        );
        return false;
      }

      showAvailability(
        "This date is available for a booking request.",
        "available"
      );

      submitBookingBtn.disabled = false;
      return true;
    }

    // Set earliest selectable date
    eventDateInput.min = getTodayKey();

    // Validate whenever a customer changes the date
    eventDateInput.addEventListener(
      "change",
      validateSelectedDate
    );

    eventDateInput.addEventListener(
      "input",
      validateSelectedDate
    );

    // Recheck when returning to the page
    window.addEventListener("pageshow", () => {
      eventDateInput.min = getTodayKey();
      validateSelectedDate();
    });

    // Prevent accidental form submission with an
    // unavailable date on the client side.
    bookingForm.addEventListener("submit", (event) => {
      eventDateInput.min = getTodayKey();

      if (!validateSelectedDate()) {
        event.preventDefault();
        eventDateInput.focus();
      }
    });

    // Initial validation
    validateSelectedDate();
  </script>

</body>

</html>