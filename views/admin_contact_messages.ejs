<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Contact Messages | BookMyArtist</title>

  <link rel="stylesheet" href="/css/admin_contact_messages.css">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >
</head>

<body>

  <nav>
    <div class="logo">
      BookMyArtist
    </div>

    <div class="nav-links">
      <a href="/admin-dashboard">
        <i class="fa-solid fa-gauge"></i>
        Dashboard
      </a>

      <a href="/admin/contact-messages" class="active">
        <i class="fa-solid fa-envelope"></i>
        Contact Messages
      </a>

      <a href="/admin/profile">
        <i class="fa-solid fa-user-shield"></i>
        My Profile
      </a>

      <a href="/auth/logout">
        <i class="fa-solid fa-right-from-bracket"></i>
        Logout
      </a>
    </div>
  </nav>


  <main>

    <div class="page-header">

      <div>
        <p class="eyebrow">ADMIN PANEL</p>

        <h1>Contact Messages</h1>

        <p>
          View and manage messages submitted through the BookMyArtist contact form.
        </p>
      </div>

      <div class="message-count">
        <i class="fa-solid fa-envelope"></i>

        <span>
          <%= messages.length %>
        </span>

        Messages
      </div>

    </div>


    <section class="messages-container">

      <% if (messages.length > 0) { %>

        <% messages.forEach(message => { %>

          <div class="message-card <%= message.is_read ? 'read' : 'unread' %>">

            <div class="message-top">

              <div class="sender">

                <div class="sender-icon">
                  <i class="fa-solid fa-user"></i>
                </div>

                <div>
                  <h3>
                    <%= message.name %>
                  </h3>

                  <p>
                    <%= message.email %>
                  </p>
                </div>

              </div>


              <div class="message-status">

                <% if (message.is_read) { %>

                  <span class="read-badge">
                    <i class="fa-solid fa-check"></i>
                    Read
                  </span>

                <% } else { %>

                  <span class="unread-badge">
                    <i class="fa-solid fa-circle"></i>
                    Unread
                  </span>

                <% } %>

              </div>

            </div>


            <div class="message-content">

              <h2>
                <%= message.subject %>
              </h2>

              <p>
                <%= message.message %>
              </p>

            </div>


            <div class="message-footer">

  <span>
    <i class="fa-regular fa-clock"></i>

    <%= new Date(message.created_at).toLocaleString() %>
  </span>


  <div class="message-actions">

    <% if (!message.is_read) { %>

      <form
        action="/admin/contact-messages/<%= message.message_id %>/read"
        method="POST"
      >

        <button type="submit" class="read-btn">
          <i class="fa-solid fa-check"></i>
          Mark as Read
        </button>

      </form>

    <% } %>


    <form
      action="/admin/contact-messages/<%= message.message_id %>/delete"
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this message?');"
    >

      <button type="submit" class="delete-btn">
        <i class="fa-solid fa-trash"></i>
        Delete
      </button>

    </form>

  </div>

</div>

          </div>

        <% }) %>

      <% } else { %>

        <div class="empty-state">

          <i class="fa-solid fa-envelope-open"></i>

          <h2>No Contact Messages</h2>

          <p>
            There are currently no messages from visitors.
          </p>

        </div>

      <% } %>

    </section>

  </main>

</body>

</html>
