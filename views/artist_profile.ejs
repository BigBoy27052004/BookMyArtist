<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= artist.stage_name %> | BookMyArtist
  </title>

  <!-- GOOGLE FONT -->

  <link rel="preconnect" href="https://fonts.googleapis.com" />

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- FONT AWESOME -->

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: #0f172a;
      color: #f8fafc;
    }

    /* NAVBAR */

    nav {
      width: 100%;
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .logo {
      font-size: 28px;
      font-weight: 700;
      color: white;
    }

    .nav-links {
      display: flex;
      gap: 35px;
    }

    .nav-links a {
      text-decoration: none;
      color: #f8fafc;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: #6c63ff;
    }

    .nav-buttons {
      display: flex;
      gap: 15px;
    }

    .nav-buttons a {
      text-decoration: none;
    }

    .btn {
      padding: 10px 22px;
      border-radius: 30px;
      font-weight: 500;
    }

    .login-btn {
      border: 1px solid #6c63ff;
      color: white;
    }

    .signup-btn {
      background: linear-gradient(to right, #6c63ff, #a855f7);
      color: white;
    }


    /* LOGGED-IN USER NAVIGATION */

    .logo {
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-links {
      align-items: center;
    }

    .nav-links a {
      font-weight: 500;
      white-space: nowrap;
    }

    .nav-links a.active {
      color: #6c63ff;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .profile-pic,
    .profile-fallback {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 3px solid #6c63ff;
      flex-shrink: 0;
    }

    .profile-pic {
      object-fit: cover;
    }

    .profile-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #6c63ff;
      color: white;
      font-weight: 600;
    }

    .logout {
      color: #cbd5e1;
      font-size: 15px;
      text-decoration: none;
      transition: 0.3s;
    }

    .logout:hover {
      color: #6c63ff;
    }

    .messages-nav-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .message-unread-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      height: 20px;
      padding: 0 6px;
      background: #ef4444;
      color: white;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    /* ALLOW NAVBAR CONTENT TO WRAP ON SMALLER SCREENS */

    @media (max-width: 1250px) {
      nav {
        flex-wrap: wrap;
        gap: 15px;
      }

      .nav-links {
        width: 100%;
        order: 3;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 18px;
      }
    }


    /* PROFILE */

    .profile {
      padding: 190px 8% 100px;
    }

    @media (max-width: 768px) {
      .profile {
        padding-top: 240px;
      }
    }

    .profile-container {
      max-width: 1100px;
      margin: auto;
    }

    .back-link {
      display: inline-block;
      color: #94a3b8;
      text-decoration: none;
      margin-bottom: 30px;
    }

    .back-link:hover {
      color: #6c63ff;
    }

    .profile-card {
      background: #1e293b;
      border-radius: 25px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .profile-main {
      display: grid;
      grid-template-columns: 350px 1fr;
    }

    .profile-image {
      width: 100%;
      height: 450px;
      object-fit: cover;
    }

    .profile-content {
      padding: 40px;
    }

    .artist-name-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .artist-name-row h1 {
      font-size: 38px;
    }

    .verified {
      color: #6c63ff;
      font-size: 22px;
    }

    .genre {
      display: inline-block;
      background: rgba(108, 99, 255, 0.15);
      color: #a855f7;
      padding: 8px 16px;
      border-radius: 30px;
      margin-bottom: 20px;
    }

    .bio {
      color: #cbd5e1;
      line-height: 1.8;
      margin-bottom: 25px;
    }

    .artist-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 30px;
    }

    .detail {
      color: #94a3b8;
    }

    .detail i {
      color: #6c63ff;
      margin-right: 8px;
    }

    .detail strong {
      display: block;
      color: white;
      margin-top: 5px;
    }

    .rating {
      color: gold;
      margin-bottom: 25px;
    }

    .rating small {
      color: #94a3b8;
    }

    .price {
      color: #6c63ff;
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 25px;
    }

    .book-btn {
      display: inline-block;
      padding: 14px 30px;
      border-radius: 15px;
      background: linear-gradient(to right, #6c63ff, #a855f7);
      color: white;
      text-decoration: none;
      font-weight: 500;
    }

    .book-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 20px rgba(108, 99, 255, 0.3);
    }

    /* REVIEWS */

    .reviews {
      margin-top: 40px;
    }

    .reviews h2 {
      margin-bottom: 25px;
    }

    .review-card {
      background: #1e293b;
      padding: 25px;
      border-radius: 18px;
      margin-bottom: 15px;
    }

    .review-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .reviewer {
      font-weight: 600;
    }

    .review-rating {
      color: gold;
    }

    .review-text {
      color: #cbd5e1;
      line-height: 1.7;
    }

    .review-date {
      color: #64748b;
      font-size: 12px;
      margin-top: 10px;
    }

    .no-reviews {
      color: #94a3b8;
      background: #1e293b;
      padding: 30px;
      border-radius: 18px;
    }


    /* ==========================================
   ENHANCED CUSTOMER REVIEWS
========================================== */

    .reviews-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 25px;
    }

    .reviews-title-row h2 {
      font-size: 28px;
      margin-bottom: 6px;
    }

    .reviews-title-row p {
      color: #94a3b8;
      font-size: 14px;
    }

    .reviews-total {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 10px 18px;
      background: rgba(108, 99, 255, 0.12);
      border: 1px solid rgba(108, 99, 255, 0.2);
      border-radius: 30px;
      color: #a855f7;
      font-weight: 600;
      font-size: 14px;
    }

    /* OVERALL RATING SUMMARY */

    .reviews-summary {
      display: flex;
      align-items: center;
      gap: 25px;
      padding: 28px;
      margin-bottom: 25px;
      background: #1e293b;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 25px;
    }

    .summary-score {
      font-size: 52px;
      line-height: 1;
      font-weight: 700;
      color: #ffffff;
    }

    .summary-score span {
      font-size: 18px;
      color: #94a3b8;
    }

    .summary-details {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .summary-stars {
      display: flex;
      gap: 5px;
      color: #f59e0b;
      font-size: 22px;
    }

    .summary-details p {
      font-size: 13px;
      color: #94a3b8;
    }

    /* REVIEW CARDS */

    .reviews-list {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .review-card {
      background: #1e293b;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 22px;
      padding: 28px;
      margin-bottom: 0;
      transition: 0.3s;
    }

    .review-card:hover {
      border-color: rgba(108, 99, 255, 0.5);
      transform: translateY(-2px);
    }

    .review-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 20px;
    }

    .reviewer-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .reviewer-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: linear-gradient(135deg, #6c63ff, #a855f7);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 18px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .reviewer {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 5px;
    }

    .review-date {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: #94a3b8;
      margin-top: 0;
    }

    .review-rating {
      display: flex;
      align-items: center;
      gap: 5px;
      color: #f59e0b;
      font-size: 15px;
    }

    .review-rating span {
      color: #cbd5e1;
      font-size: 13px;
      font-weight: 600;
      margin-left: 8px;
    }

    /* EVENT INFORMATION */

    .review-event {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 16px;
      background: rgba(108, 99, 255, 0.08);
      border-radius: 12px;
      margin-bottom: 18px;
      color: #cbd5e1;
      font-size: 13px;
    }

    .review-event i {
      color: #a855f7;
    }

    .event-date {
      color: #94a3b8;
    }

    /* WRITTEN REVIEW */

    .review-text {
      color: #e2e8f0;
      font-size: 14px;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }

    .review-text p {
      margin: 0;
    }

    .no-comment {
      color: #94a3b8;
      font-style: italic;
    }

    /* EMPTY REVIEWS STATE */

    .no-reviews {
      padding: 45px 25px;
      text-align: center;
      background: #1e293b;
      border-radius: 22px;
    }

    .no-reviews>i {
      display: block;
      font-size: 42px;
      color: #6c63ff;
      margin-bottom: 18px;
    }

    .no-reviews h3 {
      margin-bottom: 12px;
      color: #ffffff;
    }

    .no-reviews p {
      max-width: 480px;
      margin: auto;
      color: #94a3b8;
      line-height: 1.7;
    }

    @media (max-width: 600px) {
      .reviews-summary {
        padding: 22px;
        gap: 15px;
      }

      .summary-score {
        font-size: 42px;
      }

      .review-card {
        padding: 20px;
      }

      .review-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .review-rating {
        flex-wrap: wrap;
      }

      .reviews-title-row h2 {
        font-size: 24px;
      }
    }


    /* ==========================================
   CUSTOMER AVAILABILITY CALENDAR
========================================== */

    .customer-availability {
      margin-top: 40px;
    }

    .availability-heading {
      margin-bottom: 22px;
    }

    .availability-heading h2 {
      font-size: 27px;
      margin-bottom: 8px;
    }

    .availability-heading h2 i {
      color: #6c63ff;
      margin-right: 8px;
    }

    .availability-heading p {
      color: #94a3b8;
      font-size: 14px;
      line-height: 1.7;
    }

    .availability-calendar {
      background: #1e293b;
      border-radius: 25px;
      padding: 35px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* MONTH CONTROLS */

    .availability-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 28px;
    }

    .availability-controls h3 {
      font-size: 20px;
      font-weight: 600;
      text-align: center;
    }

    .availability-controls button {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: #0f172a;
      color: #ffffff;
      border: 1px solid #475569;
      cursor: pointer;
      transition: 0.3s;
    }

    .availability-controls button:hover {
      background: #6c63ff;
      border-color: #6c63ff;
    }

    /* LEGEND */

    .availability-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      margin-bottom: 25px;
    }

    .availability-legend span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #cbd5e1;
      font-size: 13px;
    }

    .availability-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .availability-dot.available {
      background: #22c55e;
    }

    .availability-dot.blocked {
      background: #f59e0b;
    }

    .availability-dot.booked {
      background: #ef4444;
    }

    /* CALENDAR GRID */

    .customer-weekdays,
    .customer-calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 9px;
    }

    .customer-weekdays {
      margin-bottom: 12px;
    }

    .customer-weekdays span {
      text-align: center;
      color: #94a3b8;
      font-size: 13px;
    }

    .customer-calendar-day {
      min-height: 65px;
      border-radius: 12px;
      color: #ffffff;
      border: 1px solid transparent;
      cursor: pointer;
      font-weight: 600;
      font-size: 15px;
      transition: 0.2s;
    }

    .customer-calendar-day.available {
      background: rgba(34, 197, 94, 0.12);
      color: #86efac;
    }

    .customer-calendar-day.blocked {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
    }

    .customer-calendar-day.booked {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
    }

    .customer-calendar-day.past {
      background: #263244;
      color: #64748b;
    }

    .customer-calendar-day:hover {
      border-color: #6c63ff;
    }

    .customer-calendar-day.selected {
      border: 2px solid #a855f7;
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.25);
    }

    .customer-calendar-day:focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 2px;
    }

    /* SELECTED DATE */

    .customer-date-info {
      margin-top: 25px;
      padding: 18px;
      background: #0f172a;
      border-radius: 12px;
      color: #cbd5e1;
      font-size: 14px;
      line-height: 1.7;
    }

    /* INFORMATION NOTE */

    .availability-note {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-top: 20px;
      color: #94a3b8;
      font-size: 12px;
      line-height: 1.7;
    }

    .availability-note i {
      color: #6c63ff;
      margin-top: 3px;
    }

    /* MOBILE */

    @media (max-width: 600px) {
      .availability-calendar {
        padding: 18px;
      }

      .availability-controls h3 {
        font-size: 17px;
      }

      .availability-controls button {
        width: 36px;
        height: 36px;
      }

      .customer-weekdays,
      .customer-calendar-grid {
        gap: 4px;
      }

      .customer-calendar-day {
        min-height: 42px;
        font-size: 12px;
        border-radius: 8px;
      }

      .customer-weekdays span {
        font-size: 11px;
      }

      .availability-heading h2 {
        font-size: 23px;
      }
    }

    /* RESPONSIVE */

    @media (max-width: 800px) {
      .profile-main {
        grid-template-columns: 1fr;
      }

      .profile-image {
        height: 350px;
      }

      .artist-name-row h1 {
        font-size: 30px;
      }

      .artist-details {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->

  <nav>

    <% if (user && user.role === "customer") { %>

    <!-- CUSTOMER NAVIGATION -->

    <a href="/dashboard" class="logo">
      BookMyArtist
    </a>

    <div class="nav-links">

      <a href="/dashboard">Dashboard</a>

      <a href="/artists" class="active">
        Browse Artists
      </a>

      <a href="/bookings">My Bookings</a>

      <a href="/messages" class="messages-nav-link">
        Messages

        <% if (Number(unreadCount) > 0) { %>
        <span class="message-unread-badge">
          <%= unreadCount %>
        </span>
        <% } %>
      </a>

      <a href="/reviews/customer">Reviews</a>

      <a href="#" title="Customer profile coming soon">
        Profile
      </a>

    </div>

    <div class="nav-right">

      <% if (user.profile_image) { %>

      <img src="/uploads/artist-images/<%= user.profile_image %>" alt="Profile picture" class="profile-pic">

      <% } else { %>

      <div class="profile-fallback">
        <%= (user.first_name || "U").charAt(0).toUpperCase() %>
      </div>

      <% } %>

      <a href="/auth/logout" class="logout">
        Logout
      </a>

    </div>

    <% } else if (user && user.role === "artist") { %>

    <!-- ARTIST NAVIGATION -->

    <a href="/artist-dashboard" class="logo">
      BookMyArtist
    </a>

    <div class="nav-links">

      <a href="/artist-dashboard">Dashboard</a>

      <a href="/artists">Browse Artists</a>

      <a href="/bookings/artist">Bookings</a>

      <a href="/messages" class="messages-nav-link">
        Messages

        <% if (Number(unreadCount) > 0) { %>
        <span class="message-unread-badge">
          <%= unreadCount %>
        </span>
        <% } %>
      </a>

      <a href="/reviews/artist">Reviews</a>

      <a href="/artists/my-profile">My Profile</a>

    </div>

    <div class="nav-right">

      <% if (user.profile_image) { %>

      <img src="/uploads/artist-images/<%= user.profile_image %>" alt="Profile picture" class="profile-pic">

      <% } else { %>

      <div class="profile-fallback">
        <%= (user.first_name || "A").charAt(0).toUpperCase() %>
      </div>

      <% } %>

      <a href="/auth/logout" class="logout">
        Logout
      </a>

    </div>

    <% } else { %>

    <!-- PUBLIC NAVIGATION -->

    <div class="logo">
      BookMyArtist
    </div>

    <div class="nav-links">

      <a href="/">Home</a>

      <a href="/artists">Artists</a>

      <a href="/features">Features</a>

      <a href="/about">About</a>

      <a href="/contact">Contact</a>

    </div>

    <div class="nav-buttons">

      <a href="/auth/login" class="btn login-btn">
        Login
      </a>

      <a href="/auth/register" class="btn signup-btn">
        Sign Up
      </a>

    </div>

    <% } %>

  </nav>



  <!-- PROFILE -->

  <section class="profile">

    <div class="profile-container">

      <a href="/artists" class="back-link">
        <i class="fa-solid fa-arrow-left"></i>
        Back to Artists
      </a>


      <div class="profile-card">

        <div class="profile-main">

          <!-- IMAGE -->

          <img class="profile-image" src="/uploads/artist-images/<%= artist.profile_image %>" alt="<%= artist.stage_name %>" />


          <!-- CONTENT -->

          <div class="profile-content">

            <div class="artist-name-row">

              <h1>
                <%= artist.stage_name %>
              </h1>

              <% if (artist.is_verified) { %>

              <span class="verified">
                <i class="fa-solid fa-circle-check"></i>
              </span>

              <% } %>

            </div>


            <div class="genre">
              <%= artist.genre || "Genre not specified" %>
            </div>


            <p class="bio">

              <%= artist.biography ||
                "This artist has not added a biography yet." %>

            </p>


            <!-- DETAILS -->

            <div class="artist-details">

              <div class="detail">

                <i class="fa-solid fa-location-dot"></i>

                Location

                <strong>

                  <%= artist.city || "" %>

                  <% if (artist.city && artist.province) { %>
                  ,
                  <% } %>

                  <%= artist.province ||
                    "Not specified" %>

                </strong>

              </div>


              <div class="detail">

                <i class="fa-solid fa-star"></i>

                Rating

                <strong>

                  <% if (Number(artist.review_count) > 0) { %>

                  <%= Number(artist.average_rating).toFixed(1) %>
                  / 5

                  (<%= artist.review_count %> reviews)

                  <% } else { %>

                  No ratings yet

                  <% } %>

                </strong>

              </div>

            </div>


            <!-- PRICE -->

            <div class="price">

              <% if (artist.booking_price) { %>

              R<%= Number(artist.booking_price)
                  .toLocaleString("en-ZA") %>

              <% } else { %>

              Price on request

              <% } %>

            </div>


            <!-- BOOK -->

            <a href="/bookings/create/<%= artist.artist_id %>" class="book-btn">

              <i class="fa-solid fa-calendar-check"></i>

              Book This Artist

            </a>

          </div>

        </div>

      </div>


      <!-- CUSTOMER AVAILABILITY CALENDAR -->

      <section class="customer-availability">

        <div class="availability-heading">
          <div>
            <h2>
              <i class="fa-regular fa-calendar-days"></i>
              Artist Availability
            </h2>

            <p>
              Check available dates before requesting
              a booking with <%= artist.stage_name %>.
            </p>
          </div>
        </div>

        <div class="availability-calendar">

          <!-- MONTH CONTROLS -->

          <div class="availability-controls">

            <button type="button" id="customerPrevMonth" aria-label="Previous month">
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <h3 id="customerCalendarMonth"></h3>

            <button type="button" id="customerNextMonth" aria-label="Next month">
              <i class="fa-solid fa-chevron-right"></i>
            </button>

          </div>

          <!-- LEGEND -->

          <div class="availability-legend">

            <span>
              <i class="availability-dot available"></i>
              Available
            </span>

            <span>
              <i class="availability-dot blocked"></i>
              Unavailable
            </span>

            <span>
              <i class="availability-dot booked"></i>
              Booked
            </span>

          </div>

          <!-- WEEKDAYS -->

          <div class="customer-weekdays">
            <span>Sun</span>
            <span>Mon</span>
            <span>Tue</span>
            <span>Wed</span>
            <span>Thu</span>
            <span>Fri</span>
            <span>Sat</span>
          </div>

          <!-- DAYS ADDED BY JAVASCRIPT -->

          <div class="customer-calendar-grid" id="customerCalendarGrid"></div>

          <!-- SELECTED DATE STATUS -->

          <div class="customer-date-info" id="customerDateInfo" aria-live="polite">
            Select a date to view availability.
          </div>

          <p class="availability-note">
            <i class="fa-solid fa-circle-info"></i>
            Availability can change. Dates are checked
            again when booking requests are processed.
          </p>

        </div>

      </section>



      <!-- CUSTOMER REVIEWS -->

      <div class="reviews">

        <div class="reviews-title-row">
          <div>
            <h2>Customer Reviews</h2>
            <p>See what customers say about this artist.</p>
          </div>

          <span class="reviews-total">
            <i class="fa-solid fa-comment-dots"></i>
            <%= Number(artist.review_count) %>
            <%= Number(artist.review_count) === 1
        ? "Review"
        : "Reviews" %>
          </span>
        </div>

        <!-- OVERALL RATING -->

        <% if (Number(artist.review_count) > 0) { %>

        <div class="reviews-summary">

          <div class="summary-score">
            <%= Number(artist.average_rating).toFixed(1) %>
            <span>/ 5</span>
          </div>

          <div class="summary-details">

            <div class="summary-stars" aria-label="Average rating: <%= Number(artist.average_rating).toFixed(1) %> out of 5 stars">

              <% for (let i = 1; i <= 5; i++) { %>
              <i class="<%= i <= Math.round(Number(artist.average_rating))
              ? 'fa-solid'
              : 'fa-regular' %> fa-star"></i>
              <% } %>

            </div>

            <p>
              Based on <%= Number(artist.review_count) %>
              customer <%= Number(artist.review_count) === 1
            ? "review"
            : "reviews" %>
            </p>

          </div>

        </div>

        <% } %>

        <!-- INDIVIDUAL REVIEWS -->

        <% if (reviews && reviews.length > 0) { %>

        <div class="reviews-list">

          <% reviews.forEach(review => { %>

          <article class="review-card">

            <div class="review-header">

              <div class="reviewer-info">

                <div class="reviewer-avatar">
                  <%= (review.first_name || "C")
                  .charAt(0).toUpperCase() %>
                </div>

                <div>
                  <h3 class="reviewer">
                    <%= review.first_name %>
                    <%= review.last_name %>
                  </h3>

                  <span class="review-date">
                    <i class="fa-regular fa-clock"></i>
                    <%= new Date(review.created_at)
                    .toLocaleDateString("en-ZA", {
                      day: "2-digit",
                      month: "long",
                      year: "numeric"
                    }) %>
                  </span>
                </div>

              </div>

              <div class="review-rating" aria-label="<%= review.rating %> out of 5 stars">

                <% for (let i = 1; i <= 5; i++) { %>

                <i class="<%= i <= Number(review.rating)
                  ? 'fa-solid'
                  : 'fa-regular' %> fa-star"></i>

                <% } %>

                <span>
                  <%= review.rating %>/5
                </span>

              </div>

            </div>

            <!-- EVENT -->

            <% if (review.event_name) { %>

            <div class="review-event">

              <i class="fa-solid fa-calendar-check"></i>

              <span>
                Event: <%= review.event_name %>
              </span>

              <% if (review.event_date) { %>

              <span class="event-date">
                •
                <%= new Date(review.event_date)
                    .toLocaleDateString("en-ZA", {
                      day: "2-digit",
                      month: "long",
                      year: "numeric"
                    }) %>
              </span>

              <% } %>

            </div>

            <% } %>

            <!-- REVIEW TEXT -->

            <div class="review-text">

              <% if (review.review) { %>
              <p><%= review.review %></p>
              <% } else { %>
              <p class="no-comment">
                No written review provided.
              </p>
              <% } %>

            </div>

          </article>

          <% }) %>

        </div>

        <% } else { %>

        <div class="no-reviews">

          <i class="fa-regular fa-star"></i>

          <h3>No Customer Reviews Yet</h3>

          <p>
            This artist hasn't received any customer
            reviews yet. Be among the first to book
            and share your experience!
          </p>

        </div>

        <% } %>

      </div>


    </div>

  </section>


  <!-- AVAILABILITY DATA FROM MYSQL -->

  <script id="customerAvailabilityData" type="application/json">
    <%- JSON.stringify({
  blocked: unavailableDates.map(item => item.date),
  booked: bookedDates.map(item => item.date)
}).replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029") %>
  </script>

  <script>
    const customerAvailability = JSON.parse(
      document.getElementById(
        "customerAvailabilityData"
      ).textContent
    );

    const blockedDates = new Set(
      customerAvailability.blocked
    );

    const bookedDates = new Set(
      customerAvailability.booked
    );

    const calendarGrid = document.getElementById(
      "customerCalendarGrid"
    );

    const calendarMonth = document.getElementById(
      "customerCalendarMonth"
    );

    const dateInfo = document.getElementById(
      "customerDateInfo"
    );

    let displayedMonth = new Date();
    displayedMonth.setDate(1);

    function formatDateKey(year, month, day) {
      return [
        year,
        String(month + 1).padStart(2, "0"),
        String(day).padStart(2, "0")
      ].join("-");
    }

    function getTodayKey() {
      const today = new Date();

      return formatDateKey(
        today.getFullYear(),
        today.getMonth(),
        today.getDate()
      );
    }

    function displayDateStatus(date) {
      const readableDate = new Date(
        date + "T12:00:00"
      ).toLocaleDateString("en-ZA", {
        day: "numeric",
        month: "long",
        year: "numeric"
      });

      let status;

      if (bookedDates.has(date)) {
        status = "Booked — this date is reserved.";
      } else if (blockedDates.has(date)) {
        status = "Unavailable — the artist has blocked this date.";
      } else if (date < getTodayKey()) {
        status = "Past date — booking requests are unavailable.";
      } else {
        status = "Available for booking requests.";
      }

      dateInfo.textContent =
        readableDate + ": " + status;
    }

    function renderCustomerCalendar() {
      calendarGrid.innerHTML = "";

      dateInfo.textContent =
        "Select a date to view availability.";

      const year = displayedMonth.getFullYear();
      const month = displayedMonth.getMonth();

      calendarMonth.textContent =
        displayedMonth.toLocaleDateString("en-ZA", {
          month: "long",
          year: "numeric"
        });

      const firstDay = new Date(
        year, month, 1
      ).getDay();

      const daysInMonth = new Date(
        year, month + 1, 0
      ).getDate();

      // Empty spaces before the first day
      for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement("div");
        empty.className = "customer-calendar-empty";
        calendarGrid.appendChild(empty);
      }

      // Create calendar dates
      for (let day = 1; day <= daysInMonth; day++) {

        const date = formatDateKey(year, month, day);

        const button = document.createElement("button");

        button.type = "button";
        button.textContent = day;
        button.className = "customer-calendar-day";

        let statusClass;

        if (bookedDates.has(date)) {
          statusClass = "booked";
        } else if (blockedDates.has(date)) {
          statusClass = "blocked";
        } else if (date < getTodayKey()) {
          statusClass = "past";
        } else {
          statusClass = "available";
        }

        button.classList.add(statusClass);

        button.setAttribute(
          "aria-label",
          date + " - " + statusClass
        );

        button.addEventListener("click", () => {
          document.querySelectorAll(
            ".customer-calendar-day"
          ).forEach(item => {
            item.classList.remove("selected");
          });

          button.classList.add("selected");
          displayDateStatus(date);
        });

        calendarGrid.appendChild(button);
      }
    }

    document.getElementById("customerPrevMonth")
      .addEventListener("click", () => {
        displayedMonth.setMonth(
          displayedMonth.getMonth() - 1
        );

        renderCustomerCalendar();
      });

    document.getElementById("customerNextMonth")
      .addEventListener("click", () => {
        displayedMonth.setMonth(
          displayedMonth.getMonth() + 1
        );

        renderCustomerCalendar();
      });

    renderCustomerCalendar();
  </script>

</body>

</html>