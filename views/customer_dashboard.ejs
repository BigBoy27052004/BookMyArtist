<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard | BookMyArtist</title>

  <!-- GOOGLE FONT -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- FONT AWESOME -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <link rel="stylesheet" href="/css/customer_dashboard.css" />
</head>

<body>
  <!-- NAVBAR -->
  <nav>
    <div class="logo">BookMyArtist</div>


    <div class="nav-links">
      <a href="/dashboard" class="active">Dashboard</a>

      <a href="/artists">Browse Artists</a>

      <a href="/bookings">My Bookings</a>

      <a href="/messages" class="messages-nav-link">
        <i class="fa-regular fa-envelope"></i>
        Messages

        <% if (Number(unreadCount) > 0) { %>
        <span class="message-unread-badge">
          <%= unreadCount %>
        </span>
        <% } %>
      </a>

      <a href="/reviews/customer">Reviews</a>

      <a href="/customer/profile">My Profile</a>
    </div>


    <div class="nav-right">
      <div class="notification-bell">
        <div class="notification-wrapper">

          <button class="notification-btn" type="button" onclick="toggleNotifications()">

            <i class="fa-solid fa-bell"></i>

            <% if (unreadNotifications > 0) { %>
            <span class="badge"><%= unreadNotifications %></span>
            <% } %>

          </button>

          <div class="notification-dropdown" id="notificationDropdown">

            <div class="notification-header">

              <h3>Notifications</h3>

              <% if (unreadNotifications > 0) { %>

              <form action="/notifications/read" method="POST">

                <button type="submit" class="mark-read-btn">
                  Mark all as read
                </button>

              </form>

              <% } %>

            </div>

            <div class="notification-list">

              <% if (notifications.length === 0) { %>

              <div class="no-notifications">
                <i class="fa-regular fa-bell-slash"></i>
                <p>No notifications yet.</p>
              </div>

              <% } else { %>

              
<% notifications.forEach(notification => { %>

  <% if (notification.booking_id) { %>

    <!-- Clickable booking notification -->
    <a
      href="/bookings/<%= notification.booking_id %>"
      class="notification-item notification-link <%= notification.is_read ? 'read' : 'unread' %>"
    >

      <div class="notification-icon">
        <i class="fa-solid fa-calendar-check"></i>
      </div>

      <div class="notification-content">
        <h4><%= notification.title %></h4>

        <p><%= notification.message %></p>

        <small>
          <%= new Date(notification.created_at).toLocaleString("en-ZA") %>
        </small>
      </div>

      <i class="fa-solid fa-chevron-right notification-arrow"></i>

    </a>

  <% } else { %>

    <!-- Older notifications without a booking reference -->
    <div class="notification-item <%= notification.is_read ? 'read' : 'unread' %>">

      <div class="notification-icon">
        <i class="fa-solid fa-circle-info"></i>
      </div>

      <div class="notification-content">
        <h4><%= notification.title %></h4>
        <p><%= notification.message %></p>

        <small>
          <%= new Date(notification.created_at).toLocaleString("en-ZA") %>
        </small>
      </div>

    </div>

  <% } %>

<% }) %>


              <% } %>

            </div>

          </div>

        </div>
      </div>
      <img src="/uploads/artist-images/<%= user.profile_image %>" alt="<%= user.first_name %>" class="profile-pic" />
      <a href="/auth/logout" style="color: #cbd5e1; font-size: 15px; text-decoration: none">
        <i class="fa-solid fa-right-from-bracket"></i>
        Logout
      </a>
    </div>
  </nav>

  <div class="dashboard-container">
    <!-- WELCOME BANNER -->
    <div class="welcome-banner">
      <div class="welcome-text">
        <h1>Welcome back, <%= user.first_name %> 👋</h1>
        <p>Ready to book your next artist?</p>
      </div>
      <div class="welcome-right">
        <img src="/uploads/artist-images/<%= user.profile_image %>" alt="<%= user.first_name %>" class="profile-pic" style="width: 68px; height: 68px" />
      </div>
    </div>

    <!-- STATISTICS -->
    <div class="stats-grid">
      <!-- Card 1 -->
      <div class="stat-card">
        <i class="fa-solid fa-music stat-icon"></i>
        <div class="stat-number"><%= stats.totalBookings %></div>
        <div class="stat-label">Total Bookings</div>
      </div>
      <!-- Card 2 -->
      <div class="stat-card">
        <i class="fa-solid fa-hourglass-half stat-icon" style="color: #f59e0b"></i>
        <div class="stat-number"><%= stats.pendingBookings %></div>
        <div class="stat-label">Pending Bookings</div>
      </div>
      <!-- Card 3 -->
      <div class="stat-card">
        <i class="fa-solid fa-check-circle stat-icon" style="color: #22c55e"></i>
        <div class="stat-number"><%= stats.completedBookings %></div>
        <div class="stat-label">Completed Events</div>
      </div>
      <!-- Card 4 -->
      <div class="stat-card">
        <i class="fa-solid fa-wallet stat-icon" style="color: #ec4899"></i>
        <div class="stat-number">
          R<%= Number(stats.totalSpent).toLocaleString("en-ZA") %>
        </div>
        <div class="stat-label">Total Spent</div>
      </div>
    </div>

    <!-- UPCOMING BOOKING -->
    <!-- UPCOMING BOOKING -->

    <div class="upcoming-card">

      <% if (upcomingBooking) { %>

      <div class="upcoming-left">

        <h2>Upcoming Event</h2>

        <div class="detail-row">
          <span class="detail-label">Artist</span>

          <span class="detail-value">
            <%= upcomingBooking.stage_name %>
          </span>
        </div>


        <div class="detail-row">
          <span class="detail-label">Event</span>

          <span class="detail-value">
            <%= upcomingBooking.event_name || "Not specified" %>
          </span>
        </div>


        <div class="detail-row">
          <span class="detail-label">Date</span>

          <span class="detail-value">
            <%= upcomingBooking.event_date
            ? new Date(upcomingBooking.event_date).toLocaleDateString("en-ZA", {
                day: "2-digit",
                month: "long",
                year: "numeric"
              })
            : "Not specified"
          %>
          </span>
        </div>


        <div class="detail-row">
          <span class="detail-label">Venue</span>

          <span class="detail-value">
            <%= upcomingBooking.venue || "Not specified" %>
          </span>
        </div>


        <div class="detail-row">
          <span class="detail-label">Status</span>

          <% if (upcomingBooking.status === "Pending") { %>

          <span class="status-pill pending">
            Pending
          </span>

          <% } else if (upcomingBooking.status === "Accepted") { %>

          <span class="status-pill confirmed">
            Accepted ✓
          </span>

          <% } %>

        </div>


        <div class="detail-row">

          <span class="detail-label">
            Booking Amount
          </span>

          <span class="detail-value">

            R<%= Number(
            upcomingBooking.amount || 0
          ).toLocaleString("en-ZA") %>

          </span>

        </div>


        <a href="/bookings/<%= upcomingBooking.booking_id %>" class="view-booking-btn">
          View Booking Details
        </a>

      </div>


      <!-- ARTIST IMAGE -->

      <div style="
        display: flex;
        align-items: center;
        justify-content: center;
      ">

        <img src="/uploads/artist-images/<%= upcomingBooking.profile_image %>" style="
          width: 100%;
          max-width: 380px;
          height: 300px;
          object-fit: cover;
          border-radius: 20px;
          box-shadow: 0 0 30px rgba(108, 99, 255, 0.3);
        " alt="<%= upcomingBooking.stage_name %>" />

      </div>


      <% } else { %>

      <!-- NO UPCOMING BOOKING -->

      <div style="
        width: 100%;
        text-align: center;
        padding: 40px;
      ">

        <i class="fa-solid fa-calendar-xmark" style="
          font-size: 45px;
          color: #6c63ff;
          margin-bottom: 20px;
        "></i>

        <h2>No Upcoming Events</h2>

        <p style="
          color: #94a3b8;
          margin: 10px 0 25px;
        ">
          You don't have any upcoming bookings yet.
        </p>

        <a href="/artists" class="view-booking-btn" style="
          display: inline-block;
          text-decoration: none;
        ">
          Browse Artists
        </a>

      </div>

      <% } %>

    </div>

    <div class="main-grid">
      <!-- LEFT: RECENT BOOKINGS -->
      <div class="recent-bookings">
        <div class="section-header">
          <h2>Recent Bookings</h2>
          <a href="/bookings" class="view-btn">View All</a>
        </div>

        <table>
          <thead>
            <tr>
              <th>Artist</th>
              <th>Event</th>
              <th>Date</th>
              <th>Status</th>
              <th>Amount</th>
              <th></th>
            </tr>
          </thead>
          <tbody>

            <% if (recentBookings.length === 0) { %>

            <tr>
              <td colspan="6" style="text-align:center; padding:40px; color:#94A3B8;">
                You don't have any bookings yet.
              </td>
            </tr>

            <% } else { %>

            <% recentBookings.forEach(booking => { %>

            <tr>

              <!-- ARTIST -->
              <td>
                <div class="artist-cell">

                  <img src="/uploads/artist-images/<%= booking.profile_image %>" alt="<%= booking.stage_name %>">

                  <span>
                    <%= booking.stage_name %>
                  </span>

                </div>
              </td>

              <!-- EVENT -->
              <td>
                <%= booking.event_name || "Not specified" %>
              </td>

              <!-- DATE -->
              <td>
                <%= booking.event_date
            ? new Date(booking.event_date).toLocaleDateString("en-ZA")
            : "Not specified"
          %>
              </td>

              <!-- STATUS -->
              <td>

                <% if (booking.status === "Completed") { %>

                <span class="status-pill completed">
                  Completed
                </span>

                <% } else if (booking.status === "Pending") { %>

                <span class="status-pill pending">
                  Pending
                </span>

                <% } else if (booking.status === "Accepted") { %>

                <span class="status-pill confirmed">
                  Accepted
                </span>

                <% } else if (booking.status === "Rejected") { %>

                <span class="status-pill" style="background:rgba(239,68,68,0.15); color:#EF4444;">
                  Rejected
                </span>

                <% } %>

              </td>

              <!-- PAYMENT -->
              <td>
                <% if (booking.amount) { %>
                R<%= Number(booking.amount).toLocaleString("en-ZA") %>
                <% } else { %>
                Not specified
                <% } %>
              </td>

              <!-- DETAILS -->
              <td>
                <a href="/bookings/<%= booking.booking_id %>" class="view-btn">
                  Details
                </a>
              </td>

            </tr>

            <% }) %>

            <% } %>
          </tbody>
        </table>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="sidebar-panel">
        <!-- MESSAGES PREVIEW -->
        <div class="messages-preview">
          <div class="section-header">
            <h2>Messages</h2>
            <a href="/messages" style="color: #6c63ff; text-decoration: none; font-size: 15px">
              All Messages →
            </a>
          </div>

          <% if (recentMessages.length === 0) { %>

          <div style="
        padding: 25px 10px;
        text-align: center;
        color: #94a3b8;
      ">
            No messages yet.
          </div>

          <% } else { %>

          <% recentMessages.forEach(message => { %>

          <div class="message-item">

            <img src="/uploads/artist-images/<%= message.profile_image || 'default.png' %>" class="message-avatar" alt="<%= message.stage_name || message.first_name %>" />

            <div class="message-info">

              <h4>
                <%= message.stage_name ||
                (message.first_name + " " + message.last_name) %>
              </h4>

              <div class="message-preview">
                <%= message.message %>
              </div>

            </div>

            <div class="message-time">
              <%= new Date(message.sent_at).toLocaleDateString("en-ZA") %>
            </div>

          </div>

          <% }) %>

          <% } %>
        </div>
        <!-- NOTIFICATIONS -->
        <div class="notifications-panel">
          <div class="section-header">
            <h2>Notifications</h2>
          </div>

          <% if (notifications.length === 0) { %>

          <div style="
        padding: 25px 10px;
        text-align: center;
        color: #94a3b8;
      ">
            No notifications yet.
          </div>

          <% } else { %>

          <% notifications.forEach(notification => { %>

          <div class="notif-item <%= notification.is_read ? 'read' : 'unread' %>">

            <div class="notif-icon">
              <i class="fa-solid fa-bell"></i>
            </div>

            <div>

              <strong>
                <%= notification.title %>
              </strong>

              <br />

              <span style="color: #cbd5e1; font-size: 14px">
                <%= notification.message %>
              </span>

              <br />

              <span style="color: #64748b; font-size: 12px">
                <%= new Date(notification.created_at).toLocaleDateString("en-ZA") %>
              </span>

            </div>

          </div>

          <% }) %>

          <% } %>
        </div>
      </div>
    </div>

    <!-- RECOMMENDED ARTISTS -->
    <div class="recommended" style="margin-top: 45px">
      <div class="section-header">
        <h2>Recommended For You</h2>
        <a href="/artists" style="color: #6c63ff">Browse All Artists →</a>
      </div>

      <div class="artist-scroll">

        <% if(recommendedArtists.length === 0){ %>

        <p style="padding:20px;">
          No artists registered yet.
        </p>

        <% } else { %>

        <% recommendedArtists.forEach(artist => { %>

        <div class="mini-artist-card">

          <img src="/uploads/artist-images/<%= artist.profile_image %>" alt="<%= artist.stage_name %>">

          <div class="mini-content">

            <h4>
              <%= artist.stage_name %>
            </h4>

            <div class="mini-genre">
              <%= artist.genre || "Artist" %>
            </div>

            <div style="color:gold; margin-bottom:8px;">

              ⭐
              <%= Number(artist.rating).toFixed(1) %>

              (<%= artist.total_reviews %> reviews)

            </div>

            <div class="mini-price">
              From R<%= Number(artist.booking_price || 0).toLocaleString("en-ZA") %>
            </div>

            <a href="/artists/<%= artist.artist_id %>" class="book-again-btn" style="display: inline-block; text-decoration: none;">
              View Artist
            </a>

          </div>

        </div>

        <% }) %>

        <% } %>

      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="quick-actions" style="margin-top: 45px">
      <h2 style="margin-bottom: 25px; text-align: center">Quick Actions</h2>

      <div class="quick-grid">

        <div class="quick-btn" role="link" tabindex="0" onclick="window.location.href='/artists'" onkeydown="if(event.key === 'Enter') window.location.href='/artists'">
          <i class="fa-solid fa-magnifying-glass"></i>
          <div>Browse Artists</div>
        </div>

        <div class="quick-btn" role="link" tabindex="0" onclick="window.location.href='/bookings'" onkeydown="if(event.key === 'Enter') window.location.href='/bookings'">
          <i class="fa-solid fa-calendar-check"></i>
          <div>View My Bookings</div>
        </div>

        <div class="quick-btn" role="link" tabindex="0" onclick="window.location.href='/messages'" onkeydown="if(event.key === 'Enter') window.location.href='/messages'">
          <i class="fa-solid fa-envelope"></i>
          <div>
            Messages
            <% if (Number(unreadCount) > 0) { %>
            <span class="message-unread-badge">
              <%= unreadCount %>
            </span>
            <% } %>
          </div>
        </div>

        <div class="quick-btn" title="Customer profile editing coming soon">
          <i class="fa-solid fa-user-pen"></i>
          <div>Edit Profile</div>
        </div>

      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-links">
      <a href="#">About Us</a>
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
      <a href="#">Contact</a>
      <a href="#">Help Center</a>
    </div>
    <p>© 2026 BookMyArtist. All Rights Reserved.</p>
  </footer>
  <script src="/js/dashboard.js"></script>
  <script>
    function toggleNotifications() {
      const dropdown = document.getElementById("notificationDropdown");

      dropdown.classList.toggle("show");
    }

    document.addEventListener("click", function(event) {
      const wrapper = document.querySelector(".notification-wrapper");
      const dropdown = document.getElementById("notificationDropdown");

      if (!wrapper || !dropdown) {
        return;
      }

      if (!wrapper.contains(event.target)) {
        dropdown.classList.remove("show");
      }
    });
  </script>
</body>

</html>
